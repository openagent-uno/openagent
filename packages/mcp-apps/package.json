{
  "name": "@openagent/mcp-apps",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Optional source-bound MCP Apps host and isolated browser sandbox",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs"
    },
    "./sandbox": "./src/sandbox.mjs",
    "./desktop": {
      "types": "./src/desktop.d.ts",
      "default": "./src/desktop.mjs"
    },
    "./browser-operator": {
      "types": "./src/browser-operator.d.ts",
      "import": "./src/browser-operator.mjs"
    }
  },
  "files": [
    "src",
    "fixtures",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "typesVersions": {
    "*": {
      "desktop": [
        "src/desktop.d.ts"
      ],
      "browser-operator": [
        "src/browser-operator.d.ts"
      ]
    }
  }
}
