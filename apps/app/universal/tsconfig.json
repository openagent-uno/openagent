{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@common/*": ["../common/*"],
      "@noble/ed25519": ["./node_modules/@noble/ed25519"],
      "@windwalker-io/srp": ["./node_modules/@windwalker-io/srp"],
      "cbor2": ["./node_modules/cbor2"],
      "rfc4648": ["./node_modules/rfc4648"],
      "react-native": ["./node_modules/react-native"],
      "expo-secure-store": ["./node_modules/expo-secure-store"]
    }
